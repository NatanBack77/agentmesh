{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeshNotch",
  "version": "0.1.2",
  "identifier": "dev.agentmesh.meshnotch-linux",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "notch",
        "url": "notch.html",
        "width": 360,
        "height": 480,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false
      },
      {
        "label": "settings",
        "title": "MeshNotch Settings",
        "url": "settings.html",
        "width": 560,
        "height": 640,
        "minWidth": 480,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.png"],
    "targets": ["appimage", "deb", "rpm"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NjM2MTczOUM3OTI0RTIKUldUaUpIbWNjMkZqOUgwVGMzRTRNRmlsYXQrS1Z0eHZhY3FlcUpaWHRNQ2xOQUp0ZlNNLzZzTlUK",
      "endpoints": [
        "https://github.com/NatanBack77/agentmesh/releases/latest/download/latest.json"
      ]
    }
  }
}
